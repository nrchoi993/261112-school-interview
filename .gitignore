# 의존성·빌드 결과
node_modules/
dist/

# 환경 변수: 실제 API 키가 들어 있으므로 절대 커밋하지 않아요
.env
.env.local
.env.*.local
# 키 없는 예시 파일은 올려도 돼요
!.env.example

# 기타
.DS_Store
*.log
.vite/
.vercel

# 얼굴 분석 실행 파일(빌드할 때 node_modules에서 자동 복사)
public/mediapipe/wasm/
# 얼굴 모델을 직접 받아 두었다면 올려도 돼요(약 3.7MB). 기본은 Google 공식 주소에서 받아요.
