# ===== 환경 변수 예시 (실제 키를 여기에 쓰지 마세요) =====
# 내 컴퓨터: 이 파일을 복사해 .env.local을 만들고 값을 넣은 뒤 npm run dev를 다시 시작하세요.
# Vercel: 프로젝트 → Settings → Environment Variables에 같은 이름으로 넣으세요.
# 이 값들은 서버 함수(api/)에서만 읽어요. VITE_로 시작하지 않으니 브라우저 코드에 들어가지 않아요.

# [필수] OpenAI API 키
OPENAI_API_KEY=sk-proj-여기에_본인_키를_입력

# [선택] 답변 평가·코치 대화 모델 (비워 두면 gpt-6.1-terra)
#   gpt-6.1-terra: 입력 $1 / 출력 $5 (100만 토큰당). gpt-6.1-sol보다 절반 가격이고 할루시네이션 지표도 더 낮아요.
OPENAI_MODEL=gpt-6.1-terra

# [선택] 교사 첫 비밀번호. 비워 두면 00000000이고, 처음 들어올 때 새 비밀번호를 정해야 해요.
TEACHER_PASSWORD=

# [선택] 실전 면접 음성 설정
# 면접관 목소리(TTS). gpt-4o-mini-tts는 OpenAI 공지상 2027.1.6. 종료 예정이에요.
# 종료되거나 오류가 나면 브라우저 내장 음성으로 자동으로 바뀌어요.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE_FEMALE=marin
OPENAI_TTS_VOICE_MALE=cedar
# 받아쓰기(STT)
OPENAI_STT_MODEL=gpt-transcribe

# [자동] 저장소: Vercel → Storage → Upstash(Redis)를 연결하면 자동으로 들어와요. 직접 넣지 않아도 돼요.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
